# Copy this file to .env (locally) and fill in real values,
# or set the same two variables in Vercel → Project → Settings → Environment Variables.
#
# Where to find these: Supabase Dashboard → Project Settings → API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "anon / public" key (NOT the service_role key)
#
# The site works fine without these set (it just runs on static demo data).
# Once set, the Notice Board, Gallery/Video uploads, and Admin Portal switch
# to using your real database automatically — no code changes needed.

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
